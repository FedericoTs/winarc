{
  "name": "winarc",
  "private": true,
  "version": "0.1.0",
  "description": "Squad season app: contract, dual-cam proof, squad board, Sunday ledger, episodes.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "domain:test": "pnpm --filter @winarc/domain test",
    "db:test": "pnpm --filter @winarc/db-tests test",
    "mobile": "pnpm --filter @winarc/mobile start",
    "mobile:go": "pnpm --filter @winarc/mobile start --go",
    "web": "pnpm --filter @winarc/web dev",
    "eval:verification": "pnpm --filter @winarc/eval-verification run eval",
    "mobile:bundle": "pnpm --filter @winarc/mobile bundle:check",
    "eas": "cd apps/mobile && eas",
    "ios:dev": "cd apps/mobile && eas build --platform ios --profile development"
  }
}
