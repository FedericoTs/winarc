# Copy to .env in each app that needs it. Never commit real values.

# Supabase (apps/mobile, apps/web)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics (apps/mobile). Leave the key empty to send nothing.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Edge functions (set with `supabase secrets set`)
ANTHROPIC_API_KEY=
VERIFY_MODEL=claude-opus-5

# Evals (local)
# ANTHROPIC_API_KEY as above

# Season
SEASON_ID=S01
